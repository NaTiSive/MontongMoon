generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Owner {
  id           Int      @id @default(1)
  ownerName    String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Broker {
  id             String   @id @default(uuid())
  brokerName     String
  email          String   @unique
  phone          String
  passwordHash   String
  approvalStatus String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ✅ ฝั่งตรงข้ามของความสัมพันธ์กับ Contract
  contracts Contract[] @relation("BrokerContracts")
}

enum ContractStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Contract {
  id            String         @id @default(uuid())
  brokerId      String
  broker        Broker         @relation("BrokerContracts", fields: [brokerId], references: [id], onDelete: Cascade)
  qtyEstimateKg Int
  priceByGrade  Json
  paymentTerm   String
  note          String?
  status        ContractStatus @default(PENDING)
  contractDate  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
