generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Owner {
  id           Int      @id @default(1)
  ownerName    String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Broker {
  id             String   @id @default(uuid())
  brokerName     String
  email          String   @unique
  phone          String
  passwordHash   String
  approvalStatus String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
